                { "key": "max_price", "value": "200" }
              ]
            },
            "description": "Passing min_price greater than max_price."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Message explains min_price cannot exceed max_price\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.include(\"min_price cannot be greater than max_price\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "23 - Route Not Found Fallback (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/unknown-route-test",
              "host": ["{{baseUrl}}"],
