    {
      "name": "2. Query Parameters & Filtering",
      "item": [
        {
          "name": "07 - Search by Title (search_q=java)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=java",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "search_q",
                  "value": "java"
                }
              ]
            },
            "description": "Filter books whose title contains the substring 'java' using SQL LIKE."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Every returned book title contains 'java'\", function () {",
                  "    var books = pm.response.json();",
                  "    pm.expect(books.length).to.be.above(0);",
                  "    books.forEach(function(b) {",
                  "        pm.expect(b.title.toLowerCase()).to.include('java');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "08 - Sort by Price ASC (order_by=price&order=ASC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=ASC",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "order_by",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "ASC"
                }
              ]
            },
            "description": "Sort books by price in ascending order."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Books are sorted by price ascending\", function () {",
                  "    var books = pm.response.json();",
                  "    for (var i = 1; i < books.length; i++) {",
                  "        pm.expect(books[i].price).to.be.at.least(books[i-1].price);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "09 - Sort by Price DESC (order_by=price&order=DESC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=DESC",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "order_by",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "DESC"
