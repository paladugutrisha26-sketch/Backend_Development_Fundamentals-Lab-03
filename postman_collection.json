            }
          ]
        },
        {
          "name": "11 - Price Range Filter (min_price=300&max_price=800)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?min_price=300&max_price=800",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "min_price",
                  "value": "300"
                },
                {
                  "key": "max_price",
                  "value": "800"
                }
              ]
            },
            "description": "Filter books where price is between 300 and 800 inclusive."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All books are within price range 300 - 800\", function () {",
                  "    var books = pm.response.json();",
                  "    pm.expect(books.length).to.be.above(0);",
                  "    books.forEach(function(b) {",
                  "        pm.expect(b.price).to.be.at.least(300);",
                  "        pm.expect(b.price).to.be.at.most(800);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "12 - Combined Full Query (Lab 3 Prompt Example)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=java&order_by=price&order=ASC&limit=5&offset=0&min_price=100&max_price=1000",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "search_q", "value": "java" },
                { "key": "order_by", "value": "price" },
                { "key": "order", "value": "ASC" },
                { "key": "limit", "value": "5" },
                { "key": "offset", "value": "0" },
                { "key": "min_price", "value": "100" },
                { "key": "max_price", "value": "1000" }
              ]
            },
            "description": "Prompt example: GET /books?search_q=java&order_by=price&order=ASC&limit=5&offset=0&min_price=100&max_price=1000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Filtered results match all search, price, and limit criteria\", function () {",
                  "    var books = pm.response.json();",
                  "    pm.expect(books.length).to.be.at.most(5);",
                  "    books.forEach(function(b) {",
                  "        pm.expect(b.title.toLowerCase()).to.include('java');",
                  "        pm.expect(b.price).to.be.at.least(100);",
                  "        pm.expect(b.price).to.be.at.most(1000);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
